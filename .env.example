# Copy to .env and adjust. Every value is optional for local testing.

APP_NAME=FunnelHub CRM

# Where the SQLite database and generated secret key are stored.
# DATA_DIR=./backend/data

# Leave blank to use SQLite in DATA_DIR. For PostgreSQL (install psycopg first):
# DATABASE_URL=postgresql+psycopg://crm:password@localhost:5432/funnelhub
DATABASE_URL=

# JWT signing key, also used to encrypt saved integration tokens.
# WARNING: changing it later logs everyone out AND makes saved integration tokens unreadable
# (you'd re-enter them on the Integrations page).
# JWT signing key. Leave blank and one is generated and saved in DATA_DIR/.secret_key.
# For production, set a long random value, e.g.:  python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Login lifetime in minutes (default 7 days).
TOKEN_MINUTES=10080

# Browser origins allowed to call the API directly (the Vite dev server by default).
CORS_ORIGINS=http://localhost:5173

# Set to false in production to hide the "Load demo data" action.
ALLOW_DEMO_SEED=true

# Background sync of connected platforms (YouTube, Facebook, Square, Rumble). Set false to sync manually only.
SYNC_SCHEDULER=true

# Docker only: which server address/port the CRM listens on.
# Use your Tailscale IP (tailscale ip -4) to reach it from your tailnet only.
# 127.0.0.1 = this server only. Avoid 0.0.0.0 unless it is behind HTTPS + a firewall.
CRM_BIND=127.0.0.1
CRM_PORT=8000
